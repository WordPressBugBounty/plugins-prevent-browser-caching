msgid "Exclusions"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:344
msgid "One per line: a part of a URL or an exact script/style handle. Matching styles, scripts and images are never versioned."
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:349
msgid "Advanced"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:353
msgid "Also version external URLs (CDN, third-party scripts)"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:355
msgid "Off is safer: some external services (payment scripts in particular) reject URLs with an unexpected \"ver\" parameter."
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:360
