msgid "Prevent Browser Caching"
msgstr ""

#. Description of the plugin
#: prevent-browser-caching.php
msgid "Prevents browser cache problems: visitors always get the current version of your CSS, JS, images and pages, while caching keeps working."
msgstr ""

#. Author of the plugin
#: prevent-browser-caching.php
msgid "Kostya Tereshchuk"
msgstr ""

#. Author URI of the plugin
#: prevent-browser-caching.php
msgid "https://tutori.org/kostya/"
msgstr ""

