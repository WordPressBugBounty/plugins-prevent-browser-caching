msgid "Prevent Browser Caching"
msgstr ""

#. Description of the plugin
#: prevent-browser-caching.php
msgid "Prevents browser cache problems: visitors always get the current version of your CSS, JS, images and pages, while caching keeps working."
msgstr ""

#. Author of the plugin
#: prevent-browser-caching.php
msgid "Kostya Tereshchuk"
msgstr ""

#. Author URI of the plugin
#: prevent-browser-caching.php
msgid "https://tutori.org/kostya/"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:104
msgid "New in 3.0: smarter cache busting."
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:105
msgid "Your current settings still work exactly as before. The recommended setup updates the version only when a file really changes (browser caching keeps working), stops touching external URLs (payment scripts, CDNs), and adds image cache busting."
msgstr ""

