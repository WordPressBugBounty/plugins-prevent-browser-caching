msgid "Advanced"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:235
msgid "Also version external URLs (CDN, third-party scripts)"
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:237
msgid "Off is safer: some external services (payment scripts in particular) reject URLs with an unexpected \"ver\" parameter."
msgstr ""

#: includes/admin/class-prevent-browser-caching-admin-settings.php:242
